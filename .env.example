# ==============================================================================
# BINTANG TECH STUDIO — ENVIRONMENT SPECIFICATION (.env.example)
# ==============================================================================
# STATUS: M01 REPOSITORY FOUNDATION CONTRACT
# IMPORTANT:
# - NEVER commit real credentials, tokens, or private keys to source control.
# - This file documents required configuration variables across DEV/STAGING/PROD.
# - Variables are grouped by planned milestone implementation.
# ==============================================================================

# ------------------------------------------------------------------------------
# CORE PLATFORM RUNTIME (M01 Baseline)
# ------------------------------------------------------------------------------
NODE_ENV=development
PLATFORM_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000/api/v1
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# DATABASE & AUTHENTICATION (Planned for M02 & M03 — Supabase/PostgreSQL)
# ------------------------------------------------------------------------------
# Database connections are NOT active in M01.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@db.your-project.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# PAYMENT ENGINE (Planned for M08 — Provider / Tipzy)
# ------------------------------------------------------------------------------
# Payment adapters remain server-side only. Do not expose in client builds.
PAYMENT_PROVIDER_CODE=tipzy
PAYMENT_API_KEY=YOUR_PAYMENT_API_KEY_HERE
PAYMENT_API_SECRET=YOUR_PAYMENT_API_SECRET_HERE
PAYMENT_WEBHOOK_SECRET=YOUR_PAYMENT_WEBHOOK_SECRET_HERE

# ------------------------------------------------------------------------------
# CHANNEL / BOT ENGINE (Planned for M11 — Telegram & WhatsApp)
# ------------------------------------------------------------------------------
# Bot tokens must NEVER be placed in client-accessible frontend bundles.
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_WEBHOOK_SECRET=YOUR_TELEGRAM_WEBHOOK_SECRET_HERE

# ------------------------------------------------------------------------------
# ASYNC WORKER & QUEUE (Planned for M09 — Redis / Outbox)
# ------------------------------------------------------------------------------
WORKER_CONCURRENCY=5
REDIS_URL=redis://localhost:6379
