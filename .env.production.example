# ==============================================================================
# BINTANG TECH STUDIO — PRODUCTION PILOT ENVIRONMENT SPECIFICATION
# File: .env.production.example
# Target Database: nowyzlyruzlokiejvtne (Supabase PostgreSQL)
# ==============================================================================
# CAUTION: NEVER COMMIT PRODUCTION CREDENTIALS TO SOURCE CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME & HOSTING PLANE
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
PLATFORM_BASE_URL=https://bintang.tech
API_BASE_URL=https://api.bintang.tech/api/v1
WEBHOOK_BASE_URL=https://api.bintang.tech/webhooks
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL & AUTH (Target: nowyzlyruzlokiejvtne)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://nowyzlyruzlokiejvtne.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.nowyzlyruzlokiejvtne.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. TELEGRAM BOT ENGINE
# ------------------------------------------------------------------------------
# Server-side token; NEVER expose to client bundles
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_hmac_secret
TELEGRAM_BOT_USERNAME=BintangStoreBot

# ------------------------------------------------------------------------------
# 4. PAYMENT ENGINE (Status: PRODUCTION BLOCKED / PROVIDER CONFIG REQUIRED)
# ------------------------------------------------------------------------------
# For pilot slice, mock/sandbox adapter is utilized until live merchant contract is verified.
PAYMENT_PROVIDER_CODE=tipzy
PAYMENT_API_KEY=tipzy_sandbox_key_here
PAYMENT_API_SECRET=tipzy_sandbox_secret_here
PAYMENT_WEBHOOK_SECRET=tipzy_webhook_hmac_secret_here

# ------------------------------------------------------------------------------
# 5. ASYNC WORKER & QUEUE
# ------------------------------------------------------------------------------
# PostgreSQL-backed durable queue; Redis is optional/deferred
WORKER_CONCURRENCY=5
WORKER_POLL_INTERVAL_MS=3000
